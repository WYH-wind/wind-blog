# 数据库（docker compose 起的本地 Postgres 默认值）
DATABASE_URL="postgresql://wind:wind@localhost:5432/wind?schema=public"

# 会话签名密钥（≥32 字符；生产用 openssl rand -hex 32 生成）
SESSION_SECRET="change-me-to-a-random-32+-char-secret"

# 站点对外 URL（用于 SEO/OG/RSS 绝对链接）
SITE_URL="http://localhost:3000"

# 管理员密码哈希（Argon2id）。生成方式：pnpm admin:hash-password
# 管理员密码哈希。注意：.env 由 @next/env 加载，值中的 $ 必须写成 $（pnpm admin:hash-password 输出的行已转义，直接粘贴即可）
ADMIN_PASSWORD_HASH="$argon2id$v=19$..."
ADMIN_PASSWORD_HASH="$argon2id$v=19$..."
